# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual envs
.venv/
venv/
env/

# uv lockfile — not committed in this repo (deps are range-pinned in
# pyproject.toml; floors are pinned in constraints/floor.txt)
uv.lock

# Test + coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type-checker caches
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Model artefacts (downloaded to a user cache, never committed)
# Exception: the bundled YOLOX-s weights, and the WeChat QR ONNX pair
# (S-096), ship in the wheel. The second negation is required because
# `*` does not match `/`, so the YOLOX exception does not cover
# `src/arbez/_assets/wechat/`. Anything ELSE matching the patterns
# below stays ignored.
*.onnx
!src/arbez/_assets/*.onnx
!src/arbez/_assets/wechat/*.onnx
*.mlpackage/
*.mlmodel
*.tflite
*.pt
*.ckpt

# Local data — never commit images or test corpora
data/
fixtures/large/
tests/_local_only/
.private/
